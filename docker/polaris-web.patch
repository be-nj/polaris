+</script>
+
+<script setup lang="ts">
+import { ref, watch } from 'vue';
+
+import { makeArtistThumbnailURL } from '@/api/endpoints';
+
+const props = defineProps<{
+    name: string,
+}>();
+
+const missing = ref(artistsWithoutPicture.has(props.name));
+
+watch(() => props.name, (name) => {
+    missing.value = artistsWithoutPicture.has(name);
+});
+
+function onMissing() {
+    artistsWithoutPicture.add(props.name);
+    missing.value = true;
+}
