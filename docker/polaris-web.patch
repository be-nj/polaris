+	} catch (e) { }
+}
+
+export function getReturnTo(): string | null {
+	try {
+		const path = sessionStorage.getItem(returnToKey);
+		return path && path != "/" ? path : null;
+	} catch (e) {
+		return null;
+	}
+}
+
+function clearReturnTo() {
+	try {
