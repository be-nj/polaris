+// Page that was requested while signed out, to be opened after signing in.
+// This lives in session storage so that it survives the round-trip to a single sign-on provider.
+const returnToKey = "polaris_return_to";
+
+function rememberReturnTo(path: string) {
+	try {
+		sessionStorage.setItem(returnToKey, path);
+	} catch (e) { }
+}
+
+export function getReturnTo(): string | null {
+	try {
+		const path = sessionStorage.getItem(returnToKey);
+		return path && path != "/" ? path : null;
+	} catch (e) {
+		return null;
+	}
+}
+
+function clearReturnTo() {
+	try {
+		sessionStorage.removeItem(returnToKey);
+	} catch (e) { }
+}
